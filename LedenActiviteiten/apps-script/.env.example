# Kopieer naar .env en vul in.
# Apps Script leest dit bestand NIET: zet deze waarden in de editor onder
# Project Settings > Script Properties.

# ID van de aanwezigheden-spreadsheet (uit de URL: /spreadsheets/d/<ID>/edit)
SHEET_ID=

# Adres dat een mail krijgt bij een nieuwe registratie
NOTIFY_EMAIL=
