# Copy to .env and fill in.
# Apps Script does NOT read this file: put these values in the editor under
# Project Settings > Script Properties.

# ID of the attendance spreadsheet (from the URL: /spreadsheets/d/<ID>/edit)
SHEET_ID=

# Address that receives a mail on a new registration
# (fallback: 'Mail nieuwe accounts' in the settings tab takes precedence unless it is empty)
NOTIFY_EMAIL=

# Web API key of the Firebase project (Firebase console > Project settings > Web API Key);
# needed to verify a user's login (ID token)
FIREBASE_API_KEY=

# ID of the members agenda (Google Calendar > calendar settings > Integrate calendar > Agenda-ID)
# (fallback: 'Agenda-ID' in the settings tab takes precedence)
CALENDAR_ID=

# secret iCal address of that same agenda; the members page shows it after login to subscribe
# (fallback: 'Agenda-link' in the settings tab takes precedence)
AGENDA_ICAL_URL=

# --- local only (local/server.mjs), do not put in Script Properties ---
# comma-separated email addresses that become members in the local test spreadsheet,
# e.g. your own Firebase account to really log in locally
LOCAL_MEMBERS=

# own spreadsheet (.xlsx export) for the local server; empty = newest .xlsx in local/data/, or the example spreadsheet
LOCAL_XLSX=
